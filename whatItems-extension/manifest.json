{
  "manifest_version": 3,
  "name": "whatItems 북마크",
  "version": "1.0.0",
  "description": "현재 보고 있는 페이지를 whatItems에 바로 저장합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://whatitems.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "whatItems에 저장"
  }
}
